<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <PackageId>Spydersoft.OidcProxy.Net.EntraId</PackageId>
    <Version>5.4.1</Version>
    <Authors>Albert Starreveld, Spydersoft Consulting</Authors>
    <Company>Spydersoft Consulting</Company>
    <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
    <Description>An extendible framework for .NET to implement the BFF Security Pattern (a.k.a. Token Handler Pattern) in Single Page Applications. This is a Spydersoft Consulting fork/continuation of the original OidcProxy.Net project by Albert Starreveld.</Description>
    <RepositoryUrl>https://github.com/spydersoft-consulting/OidcProxy.Net</RepositoryUrl>
    <PackageTags>Yarp, Microsoft Entra Id, Authentication, Security</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>Spydersoft.OidcProxy.Net.EntraId</Title>
    <PackageProjectUrl>https://github.com/spydersoft-consulting/OidcProxy.Net</PackageProjectUrl>
    <PackageReadmeFile>Readme.md</PackageReadmeFile>        
    <PackageIcon>logo.png</PackageIcon>        
    <SignAssembly>true</SignAssembly>        
    <LangVersion>12</LangVersion>
    <PackageReleaseNotes>
      Upgrades
      - jose-jwt from 5.1.1 to 5.20
      - Microsoft.Extensions.Caching.StackExchangeRedis from 8.0.14 to 8.0.24
      - Microsoft.AspNetCore.DataProtection.StackExchangeRedis from 8.0.14 to 8.0.24
      - Microsoft.Identity.Client from 4.70.0 to 4.82.1
      - System.IdentityModel.Tokens.Jwt from 8.6.1 to 8.16.0
    </PackageReleaseNotes>
  </PropertyGroup>
  
  <ItemGroup>
    <ProjectReference Include="..\OidcProxy.Net\OidcProxy.Net.csproj" />
    <ProjectReference Include="..\OidcProxy.Net.OpenIdConnect\OidcProxy.Net.OpenIdConnect.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Duende.IdentityModel.OidcClient" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Readme.md" pack="true" PackagePath="." />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\logo.png" pack="true" PackagePath=".">
      <Link>logo.png</Link>
    </Content>
  </ItemGroup>
</Project>
